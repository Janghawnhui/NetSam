@page "/devices"
@using NetSamLite.Server.Devices
@using NetSamLite.Server.Realtime
@inject DeviceDirectoryService DirectoryService
@inject DeviceConnectionTracker ConnectionTracker
@inject IHttpClientFactory HttpClientFactory

<PageTitle>장치 목록</PageTitle>

<h1>장치 목록</h1>

<button @onclick="RefreshAsync">새로 고침</button>

@if (_devices is null)
{
    <p>불러오는 중...</p>
}
else if (_devices.Count == 0)
{
    <p>아직 수집된 장치가 없습니다.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>컴퓨터 이름</th>
                <th>제조사 / 모델</th>
                <th>OS</th>
                <th>프로세서 / 코어 수</th>
                <th>메모리</th>
                <th>디스크</th>
                <th>마지막 수집 시각</th>
                <th>설치 SW 개수</th>
                <th>연결 상태</th>
                <th>마지막 확인</th>
                <th>지금 수집</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var device in _devices)
            {
                var status = _connectionStatuses?.GetValueOrDefault(device.DeviceId);
                var isOnline = status?.IsOnline ?? false;
                <tr>
                    <td><a href="@($"devices/{device.DeviceId}")">@device.ComputerName</a></td>
                    <td>@device.Manufacturer / @device.Model</td>
                    <td>@device.OperatingSystemCaption (@device.OperatingSystemVersion)</td>
                    <td>@device.ProcessorName / @(device.ProcessorCoreCount)코어</td>
                    <td>@FormatGigabytes(device.TotalPhysicalMemoryBytes)</td>
                    <td>
                        @foreach (var disk in device.Disks)
                        {
                            <div>@disk.Model (@FormatGigabytes(disk.SizeBytes))</div>
                        }
                    </td>
                    <td>@device.LastSeenUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@device.InstalledSoftwareCount</td>
                    <td>@(isOnline ? "온라인" : "오프라인")</td>
                    <td>@(status?.LastHeartbeatUtc is { } heartbeat ? heartbeat.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-")</td>
                    <td>
                        <button disabled="@(!isOnline)" @onclick="() => CollectNowAsync(device.DeviceId)">지금 수집</button>
                        @if (_collectNowMessages.TryGetValue(device.DeviceId, out var message))
                        {
                            <div>@message</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<DeviceSummary>? _devices;
    private Dictionary<string, DeviceConnectionStatus>? _connectionStatuses;
    private readonly Dictionary<string, string> _collectNowMessages = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _devices = await DirectoryService.ListAsync(CancellationToken.None);
        var statuses = await ConnectionTracker.ListStatusesAsync(CancellationToken.None);
        _connectionStatuses = statuses.ToDictionary(s => s.DeviceId);
    }

    // Web은 Server와 별 프로세스다 — Web 프로세스의 IHubContext<AgentHub>에는 에이전트가
    // 연결돼 있지 않으므로 "지금 수집"은 Server를 가리키는 HttpClient로만 전달할 수 있다.
    private async Task CollectNowAsync(string deviceId)
    {
        var client = HttpClientFactory.CreateClient("NetSamLiteServer");
        HttpResponseMessage response;
        try
        {
            response = await client.PostAsync(
                $"/api/v1/devices/{Uri.EscapeDataString(deviceId)}/collect-now", content: null);
        }
        catch (HttpRequestException ex)
        {
            _collectNowMessages[deviceId] = $"서버에 연결할 수 없습니다: {ex.Message}";
            return;
        }

        _collectNowMessages[deviceId] = response.StatusCode switch
        {
            System.Net.HttpStatusCode.Accepted => "수집 명령을 보냈습니다. 잠시 후 새로 고침해 확인하세요.",
            System.Net.HttpStatusCode.Conflict => "장치가 오프라인이라 수집할 수 없습니다.",
            System.Net.HttpStatusCode.Forbidden => "Web이 Server와 같은 PC에서 실행 중일 때만 지금 수집을 요청할 수 있습니다.",
            System.Net.HttpStatusCode.NotFound => "등록되지 않은 장치입니다.",
            _ => $"알 수 없는 응답: {(int)response.StatusCode}",
        };
    }

    private static string FormatGigabytes(long bytes) => $"{bytes / 1024.0 / 1024.0 / 1024.0:F1} GB";
}
